[Unit]
Description=mihomo (turnout-gateway data plane)
Documentation=https://wiki.metacubex.one/
# No BindsTo= on any tunnel/VPN unit: the bypass role has no tun0. Its inputs
# are the ingress NIC (from the firewall) and the egress NIC (to the airport
# nodes), and systemd has no generic "interface is up" dependency to express
# that without networkd. iproute.sh verifies the ingress interface exists
# before installing TPROXY rules, which surfaces a missing NIC at start time
# with a clearer message than a failed unit dependency would.
After=network-online.target
Wants=network-online.target
# turnout-nft is PartOf= this unit, so stopping or restarting mihomo tears the
# TPROXY rules down. PartOf propagates stop/restart ONLY — starting mihomo does
# NOT start turnout-nft again. Without this Wants=, a mihomo crash that systemd
# restarts (Restart=on-failure below) leaves the node with no TPROXY rules at
# all: the data plane is silently dead while every unit reports "active".
# Found 2026-10-22 by stopping mihomo: after `systemctl start turnout-mihomo`
# the rules stayed gone and the watchdog, correctly seeing dataplane_rules
# failed, kept the liveness address withdrawn forever — the node could never
# recover without a manual `systemctl start turnout-nft`.
Wants=turnout-nft.service

[Service]
Type=simple
# Working dir = /var/lib/turnout/mihomo.
# turnout-gateway renders config.yaml here (matches
# data_plane.config_path in gateway.yaml).
# mihomo reads <workdir>/config.yaml automatically when no -f is given.
# rule-sets live under <workdir>/rule-sets/ (subpath, always accepted).
# SAFE_PATHS is not needed when everything is under the working dir.
ExecStartPre=/usr/local/bin/mihomo -d /var/lib/turnout/mihomo -t
ExecStart=/usr/local/bin/mihomo -d /var/lib/turnout/mihomo
Restart=on-failure
RestartSec=5
LimitNOFILE=infinity

AmbientCapabilities=CAP_NET_ADMIN CAP_NET_RAW CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/turnout /etc/turnout

[Install]
WantedBy=multi-user.target
