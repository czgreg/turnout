[Unit]
Description=Inject turnout nft rules + TPROXY iptables rules for the bypass role
# turnout-nft manages two independent things:
#   1. nft table inet turnout — DNS pass-through rule on the ingress NIC
#      (dport 53 accept, so mihomo's DNS server answers directly)
#   2. iptables TPROXY rules — intercept non-DNS TCP/UDP arriving on the
#      ingress NIC from the diverted office segment, route to mihomo's
#      tproxy-port (preserving real client sourceIP for per-terminal routing)
#
# No BindsTo= on a tunnel unit: the bypass role has no tun0. What must exist
# instead is the ingress NIC itself, and iproute.sh checks for it before
# touching iptables — see its header.
#
# PartOf=turnout-mihomo.service: when mihomo restarts, re-run iproute.sh up
# so the iptables TPROXY chain and ip rule are cleanly re-applied.
After=network-online.target turnout-mihomo.service
PartOf=turnout-mihomo.service
StartLimitIntervalSec=0

[Service]
Type=oneshot
RemainAfterExit=yes

ExecStart=/usr/sbin/nft -f /etc/turnout/nft.conf
ExecStart=/etc/turnout/iproute.sh up

ExecStop=-/usr/sbin/nft delete table inet turnout
ExecStop=-/etc/turnout/iproute.sh down

# Restart on failure so a transient iptables error (e.g. xt_TPROXY module
# not loaded yet) is retried rather than leaving the node unprotected.
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=multi-user.target
