#!/usr/sbin/nft -f
#
# turnout-gateway nft rules — table inet turnout.
#
# Bypass-role note: this table coexists with whatever NAT ruleset the host
# already runs. Upstream assumed the host ran a VPN's `table ip nat`; here
# there is no such assumption — we own `inet turnout` and touch nothing else.
#
# Render-time placeholders are replaced by install.sh.

# Idempotent: nuke and re-add.
add table inet turnout
flush table inet turnout

table inet turnout {
  chain prerouting {
    type filter hook prerouting priority mangle; policy accept;

    # DNS UDP/TCP from the diverted office segment goes to mihomo's DNS
    # server, which listens on node.ingress_ip:53 (see data_plane.dns.listen).
    # No mark needed — the kernel delivers these locally via normal routing.
    #
    # iifname pins the source interface: only traffic that arrived FROM the
    # firewall on the ingress NIC is eligible. Traffic we originate ourselves
    # (the proxied flows mihomo dials out) never matches here, which is what
    # keeps the DIRECT path from being re-captured.
    iifname "@INGRESS_IFACE@" ip saddr @CLIENT_SUBNET@ udp dport 53 accept
    iifname "@INGRESS_IFACE@" ip saddr @CLIENT_SUBNET@ tcp dport 53 accept

    # Non-DNS TCP/UDP is handled by iptables TPROXY rules in iproute.sh.
    # No fwmark here — TPROXY intercepts on the mangle table PREROUTING
    # hook at the same priority and routes packets to mihomo's tproxy-port,
    # preserving the original client sourceIP so per-terminal routing works.
  }

  # turnout-gateway API access. This chain decides which sources may open a
  # connection to the control plane's TCP port.
  #
  # Local-destined traffic is never proxied: TPROXY's chain returns on
  # `--dst-type LOCAL`, so anything addressed to this host is delivered by
  # the kernel and graded here. (Until 2026-10-22 an iptables DROP in mangle
  # PREROUTING denied client_subnet -> API_PORT first; it was removed so
  # operators can reach /ui/ from the segment they sit in — see iproute.sh.)
  #
  # The final accept makes 18080 reachable from every source by default.
  # api.allow_from remains an additive accept list, useful only when that
  # default is narrowed later.
  # install.sh substitutes @API_ALLOW_RULES@ with an awk substring match
  # (sed can't splice embedded newlines portably).
  chain input {
    type filter hook input priority filter; policy accept;
    iif "lo" tcp dport @API_PORT@ accept
@API_ALLOW_RULES@
    tcp dport @API_PORT@ accept
  }
}
